{
  "name": "agent-x402",
  "version": "0.2.0",
  "description": "x402 micropayments for AI agents: pay per API call in USDC on Base, with a spend policy enforced outside the model.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ax402": "bin/ax402.js",
    "ax402-mcp": "bin/ax402-mcp.js",
    "ax402-serve": "bin/ax402-serve.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "x402", "usdc", "base", "ai-agents", "micropayments", "crypto", "payments", "mcp"
  ],
  "files": ["bin", "src", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "echo 'No build step required for agent-x402'",
    "lint": "node --check src/*.js && node --check bin/*.js && node --check test/*.js",
    "prepublishOnly": "npm run lint && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "viem": "^2.57.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rustemmustafingovua-byte/agent-x402.git"
  },
  "bugs": {
    "url": "https://github.com/rustemmustafingovua-byte/agent-x402/issues"
  },
  "homepage": "https://github.com/rustemmustafingovua-byte/agent-x402#readme",
  "funding": {
    "custom": [
      "https://github.com/sponsors/rustemmustafingovua-byte"
    ]
  }
}